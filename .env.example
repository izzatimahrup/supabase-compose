COMPOSE_FILE=docker-compose.yml

# --- Postgres ---
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5435

# --- JWT ---
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRY=3600

# --- API Keys (HS256) ---
ANON_KEY=your_anon_key_here
SERVICE_ROLE_KEY=your_service_role_key_here

# --- Asymmetric keys (leave blank unless using) ---
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
JWT_KEYS=
JWT_JWKS=
ANON_KEY_ASYMMETRIC=
SERVICE_ROLE_KEY_ASYMMETRIC=

# --- Dashboard ---
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=your_dashboard_password

# --- Pooler ---
POOLER_TENANT_ID=garisaksara-supabase
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_DB_POOL_SIZE=5
POOLER_PROXY_PORT_TRANSACTION=6547

# --- Studio ---
STUDIO_DEFAULT_ORGANIZATION=DBKU
STUDIO_DEFAULT_PROJECT=AssetCare
OPENAI_API_KEY=

# --- URLs ---
SUPABASE_PUBLIC_URL=https://supabase-api.garisaksara.com.my
API_EXTERNAL_URL=https://supabase-api.garisaksara.com.my
SITE_URL=https://supabase-studio.garisaksara.com.my
ADDITIONAL_REDIRECT_URLS=

# --- Auth ---
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=true
ENABLE_PHONE_AUTOCONFIRM=true
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify

# --- SMTP ---
SMTP_ADMIN_EMAIL=admin@garisaksara.com.my
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=DBKU Supabase

# --- Secrets ---
SECRET_KEY_BASE=your_secret_key_base_here
VAULT_ENC_KEY=your_vault_enc_key_here
PG_META_CRYPTO_KEY=your_pg_meta_crypto_key_here

# --- Storage ---
GLOBAL_S3_BUCKET=stub
REGION=stub
STORAGE_TENANT_ID=stub
S3_PROTOCOL_ACCESS_KEY_ID=your_s3_access_key_id
S3_PROTOCOL_ACCESS_KEY_SECRET=your_s3_access_key_secret
MINIO_ROOT_USER=supa-storage
MINIO_ROOT_PASSWORD=your_minio_password

# --- Logflare ---
LOGFLARE_PUBLIC_ACCESS_TOKEN=your_logflare_public_token
LOGFLARE_PRIVATE_ACCESS_TOKEN=your_logflare_private_token

# --- Analytics ---
GOOGLE_PROJECT_ID=GOOGLE_PROJECT_ID
GOOGLE_PROJECT_NUMBER=GOOGLE_PROJECT_NUMBER
DOCKER_SOCKET_LOCATION=/var/run/docker.sock

# --- API Gateway ---
KONG_HTTP_PORT=8001
KONG_HTTPS_PORT=8444

# --- imgproxy ---
IMGPROXY_AUTO_WEBP=true

# --- PostgREST ---
PGRST_DB_SCHEMAS=public,storage,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public

# --- Functions ---
FUNCTIONS_VERIFY_JWT=false
